+		// The workflow receipt may precede cold child startup. File existence can
+		// precede its write too: inspect marker bytes only after actual runner close.
+		const waitForFile = (file: string) => new Promise<void>((resolve, reject) => {
+			let watcher: fs.FSWatcher | undefined;
+			const timer = setTimeout(() => { watcher?.close(); reject(new Error(`Fixture readiness deadline: ${file}`)); }, 10_000);
+			const done = () => { if (fs.existsSync(file)) { clearTimeout(timer); watcher?.close(); resolve(); } };
+			try {
+				watcher = fs.watch(path.dirname(file), done);
+				watcher.once("error", (error) => { clearTimeout(timer); watcher?.close(); reject(error); });
+				done();
+			} catch (error) { clearTimeout(timer); watcher?.close(); reject(error); }
+		});
+		await waitForFile(markerPath);
+		const childRunId = workflowResult.results?.[0]?.runId;
+		assert.ok(childRunId);
+		await waitForFile(path.join(DIRS.async, childRunId, "process-terminal.json"));
+		assert.equal(fs.readFileSync(markerPath, "utf-8"), "started");
