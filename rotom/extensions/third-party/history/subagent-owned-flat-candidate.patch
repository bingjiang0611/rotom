+function scopedAgentRoutingError(agent: AgentConfig): string | undefined {
+	if (agent.runner) return agent.runner.type === "external-cli" ? undefined : "external jobs or unknown runners";
+	// Declare the child tool/extension surface rather than inheriting ambient
+	// resources that can silently reintroduce unsupported nested execution.
+	if (!Array.isArray(agent.tools) || agent.tools.some(t => typeof t !== "string" || !t || /[\\/*?\[\]]/.test(t) || /\.[cm]?[jt]s$/.test(t))) return "implicit, wildcard or extension-path tools; declare tool names explicitly";
+	if (agent.tools.some(t => ["subagent", "subagent_wait", "subagent_supervisor"].includes(t))) return "nested subagent tools";
+	if (!Array.isArray(agent.extensions)) return "ambient extensions; declare extensions explicitly (empty is allowed)";
+	return undefined;
+}
+function scopedAcceptanceExecutes(value: unknown): boolean {
+	return !!value && typeof value === "object" && (("verify" in value && value.verify !== undefined)
+		|| ("review" in value && !!value.review && typeof value.review === "object" && (!("required" in value.review) || value.review.required !== false)));
+}
+/** First scoped release deliberately admits only the validated topologies.
+ * This preflight is read-only and runs before controller admission or writer
+ * setup; a rejected workflow child must not strand an unbound admission. */
+function scopedAdmissionError(params: SubagentParamsLike, deps: ExecutorDeps, ctx: ExtensionContext, workflowChild = false, ownedIdentity = workflowLaunchObservers.has(params)): string | undefined {
+	if (!EXECUTION_STORE.scope) return undefined;
+	const deny = (feature: string) => `Scoped first release does not support ${feature}; no writer is authorized.`;
+	const action = typeof params.action === "string" ? params.action.trim() : undefined;
+	if (action && !["resume", "steer", "append-step"].includes(action)) return undefined;
+	const depth = Number(process.env.PI_SUBAGENT_DEPTH ?? "0");
+	if (!Number.isSafeInteger(depth) || depth !== 0 || resolveInheritedNestedRouteFromEnv()) return deny("nested execution");
+	if (params.async !== undefined && typeof params.async !== "boolean") return deny("invalid async selection");
+	if (params.clarify !== undefined || params.foregroundOnly === true) return deny("clarification or foreground-only routing");
+	if (!ownedIdentity && (params.workflowChildAsyncId !== undefined || params.workflowKey !== undefined || params.workflowParentRunId !== undefined)) return deny("caller-supplied workflow child identity");
+	if ((params.worktree !== undefined && params.worktree !== false) || (params.isolation !== undefined && params.isolation !== "none")) return deny("worktree execution");
+	if (params.gate !== undefined) return deny("host gates");
+	if (params.chain !== undefined || params.tasks !== undefined || params.chainDir !== undefined || action === "append-step") return deny("chains, task batches or imported roots");
+	if (params.resume !== undefined) return deny("foreground resume; use native async action=resume for an eligible original run");
+	if (params.context === "fork") return deny("forked/imported sessions");
+	if (scopedAcceptanceExecutes(params.acceptance)) return deny("verification/review execution");
+	if (action) return undefined; // Target-specific native recovery fences run separately.
+	if (params.workflowScript !== undefined) return params.async === false ? deny("foreground workflow controllers") : undefined;
+	if (!params.agent) return deny("non-single launches");
+	const cwd = resolveRequestedCwd(ctx.cwd, params.cwd), discovered = deps.discoverAgents(cwd, resolveExecutionAgentScope(params.agentScope));
+	const canonical = canonicalizeExecutionParams(params, discovered.agents, discovered.agentDiagnostics);
+	if (canonical.error) return canonical.error;
+	const effective = applySingleAgentLaunchDefaults(canonical.params!, discovered.agents);
+	const agent = discovered.agents.find(a => a.name === effective.agent);
+	if (!agent || agent.disabled) return deny("an unavailable agent");
+	const routingError = scopedAgentRoutingError(agent);
+	if (routingError) return deny(routingError);
+	if (scopedAcceptanceExecutes(effective.acceptance ?? agent.defaultAcceptance)) return deny("agent verification/review execution");
+	const context = resolveAgentDefaultContextPolicy(effective, discovered.agents, deps.config.defaultSubagentContext, canPreferFork(ctx.sessionManager));
+	if (context.usesFork || context.params.context === "fork") return deny("forked/imported sessions");
+	const requestedAsync = effective.async ?? deps.asyncByDefault;
+	if (typeof requestedAsync !== "boolean") return deny("invalid effective async selection");
+	if (!requestedAsync && (!workflowChild || agent.runner)) return deny("standalone foreground or foreground external execution");
+	return undefined;
+}
