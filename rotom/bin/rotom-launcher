#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
agent_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
observability_extension_dir="$agent_dir/extensions/observability"
trace_dashboard="$observability_extension_dir/dashboard.mjs"
runtime_verifier="$agent_dir/runtime/verify-pi-runtime.mjs"
runtime_launcher="$agent_dir/runtime/launch-runtime.mjs"
herdr_extension=
if [ "${HOME+x}" = x ] && [ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_SOCKET_PATH:-}" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
	herdr_candidate="$HOME/.pi/agent/extensions/herdr-agent-state.ts"
	if [ -f "$herdr_candidate" ] && [ ! -L "$herdr_candidate" ]; then
		herdr_extension=$herdr_candidate
	fi
fi

version_probe=0
product_update=0
product_update_force=0
if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
	version_probe=1
elif [ "$#" -eq 2 ] && [ "$1" = "--version" ] && [ "$2" = "--verbose" ]; then
	version_probe=2
fi

# Pi package commands must remain the first argv item, so they cannot be
# decorated with the product's explicitly loaded runtime resources. User and
# project packages are managed by the pinned Pi package manager, while rotom's
# bundled Pi fork remains upgradeable only as part of a rotom release.
package_management_command=0
case "${1-}" in
	install|remove|uninstall|list|config)
		package_management_command=1
		;;
	update)
		package_update_target=0
		package_update_self=0
		package_update_all=0
		package_update_help=0
		package_update_invalid=
		package_update_first=1
		for argument in "$@"; do
			if [ "$package_update_first" -eq 1 ]; then
				package_update_first=0
				continue
			fi
			case "$argument" in
				--extensions|--extension|--models)
					package_update_target=1
					;;
				-h|--help)
					package_update_help=1
					;;
				--all)
					package_update_all=1
					;;
				--self|self|pi)
					package_update_self=1
					;;
				--force)
					product_update_force=1
					;;
				-a|--approve|-na|--no-approve)
					package_update_invalid=$argument
					;;
				-*)
					package_update_invalid=$argument
					;;
				*)
					package_update_target=1
					;;
			esac
		done
		if [ "$package_update_help" -eq 1 ]; then
			cat <<'EOF'
Usage:
  rotom update [--force]
  rotom update --self [--force]
  rotom update --extensions
  rotom update --extension <source>
  rotom update <source>
  rotom update --models

Update rotom itself to the exact npm latest version, or update installed Pi packages/model catalogs. Product updates support regular active global npm installations, require confirmation before replacement, and never hot-reload running sessions. --force confirms replacement and reinstalls an already-current release.
EOF
			exit 0
		fi
		if [ "$package_update_all" -eq 1 ]; then
			echo "rotom: 不支持合并的 update --all；请依次运行 rotom update 和 rotom update --extensions" >&2
			exit 2
		fi
		if [ "$package_update_self" -eq 1 ] && [ "$package_update_target" -eq 1 ]; then
			echo "rotom: 产品更新不能与 extension/model 更新目标组合" >&2
			exit 2
		fi
		if [ "$package_update_self" -eq 1 ] || [ "$package_update_target" -eq 0 ]; then
			if [ -n "$package_update_invalid" ]; then
				echo "rotom: 产品更新不支持选项 $package_update_invalid" >&2
				exit 2
			fi
			product_update=1
		else
			package_management_command=1
		fi
		;;
esac

if [ "${ROTOM_NODE+x}" = x ]; then
	node_candidate=$ROTOM_NODE
	case "$node_candidate" in
		/*) ;;
		*)
			echo "rotom: ROTOM_NODE 必须是绝对 Node 可执行文件路径" >&2
			exit 2
			;;
	esac
else
	node_candidate=
	if command -v node >/dev/null 2>&1; then
		node_candidate=$(command -v node)
	fi
	if [ -z "$node_candidate" ]; then
		echo "rotom: 找不到兼容的 Node；请安装 Node >=24.0.0 或设置 ROTOM_NODE=/absolute/path/to/node" >&2
		exit 127
	fi
	case "$node_candidate" in
		/*) ;;
		*)
			echo "rotom: PATH 中的 node 不是绝对文件路径：$node_candidate" >&2
			exit 2
			;;
	esac
fi

if [ ! -f "$node_candidate" ] || [ ! -x "$node_candidate" ]; then
	echo "rotom: Node 路径不存在、不是普通文件或不可执行：$node_candidate" >&2
	exit 2
fi

# argv never evaluate ROTOM_NODE as a command string. Prefer a fixed platform
# realpath utility so a read-only version probe starts Node only once.
realpath_command=
for candidate in /bin/realpath /usr/bin/realpath; do
	if [ -x "$candidate" ]; then
		realpath_command=$candidate
		break
	fi
done
if [ -n "$realpath_command" ]; then
	node_command=$("$realpath_command" "$node_candidate" 2>/dev/null) || node_command=
else
	node_command=$("$node_candidate" -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' "$node_candidate" 2>/dev/null) || node_command=
fi
if [ -z "$node_command" ]; then
	echo "rotom: ROTOM_NODE/PATH node 无法解析 realpath：$node_candidate" >&2
	exit 2
fi
case "$node_command" in
	/*) ;;
	*)
		echo "rotom: Node realpath 不是绝对路径" >&2
		exit 2
		;;
esac
if [ ! -f "$node_command" ] || [ ! -x "$node_command" ]; then
	echo "rotom: Node realpath 不是可执行普通文件：$node_command" >&2
	exit 2
fi

require_supported_node() {
	"$node_command" -e 'const [major] = process.versions.node.split(".").map(Number); if (major < 24) { console.error(`rotom: Node runtime ${process.versions.node} 不受支持；要求 >=24.0.0`); process.exit(1); }'
}

if [ "$product_update" -eq 1 ]; then
	require_supported_node
	product_updater="$agent_dir/runtime/update-product.mjs"
	if [ ! -f "$product_updater" ] || [ -L "$product_updater" ]; then
		echo "rotom: product updater 缺失或不是可信普通文件" >&2
		exit 2
	fi
	if [ "$product_update_force" -eq 1 ]; then
		exec "$node_command" "$product_updater" --force
	fi
	exec "$node_command" "$product_updater"
fi

if [ "${ROTOM_PI+x}" = x ]; then
	pi_candidate=$ROTOM_PI
	case "$pi_candidate" in
		/*) ;;
		*)
			echo "rotom: ROTOM_PI 必须是绝对 Pi 可执行文件路径" >&2
			exit 2
			;;
	esac
	if [ ! -f "$pi_candidate" ] || [ ! -x "$pi_candidate" ]; then
		echo "rotom: Pi 路径不存在、不是普通文件或不可执行：$pi_candidate" >&2
		exit 2
	fi
else
	installed_pi_resolver="$agent_dir/runtime/resolve-installed-pi.mjs"
	for bootstrap_path in "$agent_dir/runtime" "$installed_pi_resolver" "$runtime_verifier" "$agent_dir/runtime/product-config.mjs"; do
		if [ ! -e "$bootstrap_path" ] || [ -L "$bootstrap_path" ]; then
			echo "rotom: 缺少可信 bundled Pi resolver 资源：$bootstrap_path" >&2
			exit 2
		fi
	done
fi

if [ "$#" -eq 1 ] && [ "$1" = "--trace" ]; then
	require_supported_node
	if [ ! -f "$trace_dashboard" ] || [ -L "$trace_dashboard" ]; then
		echo "rotom: 缺少可信 trace dashboard：$trace_dashboard" >&2
		exit 1
	fi
	exec "$node_command" "$trace_dashboard"
fi

for argument in "$@"; do
	if [ "$argument" = "--trace" ]; then
		echo "rotom: --trace 必须单独使用" >&2
		exit 2
	fi
	case "$argument" in
		--no-approve|-na)
			load_claude_project_skills=0
			;;
		--approve|-a)
			load_claude_project_skills=1
			;;
	esac
done

# Deferred loading may narrow only the launcher's reviewed default surface. Any
# explicit Pi tool-selection flag remains authoritative, even if it names every
# currently registered product tool. Stop at `--` because later values are messages.
deferred_default_surface=1
for argument in "$@"; do
	if [ "$argument" = "--" ]; then
		break
	fi
	case "$argument" in
		--tools|-t|--exclude-tools|-xt|--no-tools|-nt|--no-builtin-tools|-nbt)
			deferred_default_surface=0
			break
			;;
	esac
done
ROTOM_DEFERRED_DEFAULT_SURFACE=$deferred_default_surface
export ROTOM_DEFERRED_DEFAULT_SURFACE

# Reuse Claude Code skills without copying or generating a second catalog. Project skills follow
# Claude Code's startup discovery boundary: cwd and its ancestors through the nearest Git root.
# An explicit --no-approve keeps user skills but suppresses all project-local Claude resources.
load_claude_project_skills=${load_claude_project_skills:-1}
claude_user_skill_dir=
if [ "${HOME+x}" = x ]; then
	claude_user_skill_dir="$HOME/.claude/skills"
fi
if [ "$package_management_command" -eq 0 ] && [ "$load_claude_project_skills" -eq 1 ]; then
	claude_repo_root=
	claude_probe_dir=$PWD
	while :; do
		if [ -e "$claude_probe_dir/.git" ]; then
			claude_repo_root=$claude_probe_dir
			break
		fi
		claude_parent_dir=$(dirname "$claude_probe_dir")
		if [ "$claude_parent_dir" = "$claude_probe_dir" ]; then
			break
		fi
		claude_probe_dir=$claude_parent_dir
	done
	claude_scan_dir=$PWD
	while :; do
		claude_project_skill_dir="$claude_scan_dir/.claude/skills"
		if [ -d "$claude_project_skill_dir" ] && [ "$claude_project_skill_dir" != "$claude_user_skill_dir" ]; then
			set -- --skill "$claude_project_skill_dir" "$@"
		fi
		if [ -z "$claude_repo_root" ] || [ "$claude_scan_dir" = "$claude_repo_root" ]; then
			break
		fi
		claude_parent_dir=$(dirname "$claude_scan_dir")
		if [ "$claude_parent_dir" = "$claude_scan_dir" ]; then
			break
		fi
		claude_scan_dir=$claude_parent_dir
	done
fi
if [ "$package_management_command" -eq 0 ] && [ -n "$claude_user_skill_dir" ] && [ -d "$claude_user_skill_dir" ]; then
	set -- --skill "$claude_user_skill_dir" "$@"
fi

# Run trust verification, startup defaults and the Pi entrypoint in one Node
# process. The previous pipeline started Node separately for version checks,
# runtime verification, config parsing, store initialization and Pi itself;
# process startup dominated wall-clock latency on macOS.
for bootstrap_path in "$runtime_launcher" "$runtime_verifier" "$agent_dir/runtime/resolve-installed-pi.mjs" "$agent_dir/runtime/product-config.mjs"; do
	if [ ! -f "$bootstrap_path" ] || [ -L "$bootstrap_path" ]; then
		echo "rotom: 缺少可信 bootstrap 资源：$bootstrap_path" >&2
		exit 1
	fi
done

if [ "$version_probe" -eq 1 ]; then
	exec "$node_command" "$runtime_launcher" --version-only -- "$@"
fi
if [ "$version_probe" -eq 2 ]; then
	exec "$node_command" "$runtime_launcher" --version-verbose -- "$@"
fi
if [ "$package_management_command" -eq 1 ]; then
	exec "$node_command" "$runtime_launcher" --package-management -- "$@"
fi
if [ -n "$herdr_extension" ]; then
	exec "$node_command" "$runtime_launcher" --herdr-extension "$herdr_extension" -- "$@"
fi
exec "$node_command" "$runtime_launcher" -- "$@"
